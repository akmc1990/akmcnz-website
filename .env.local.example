# Cloudinary Configuration
# Get these from your Cloudinary dashboard: https://cloudinary.com/console
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# NextAuth.js Configuration
# Generate NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=your_nextauth_secret_key

# Google OAuth (create at https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Allowed admin emails (comma-separated)
ALLOWED_ADMIN_EMAILS=admin@example.com,admin2@example.com

# Vercel API (for admin email management via /admin page)
# Create token at: https://vercel.com/account/tokens
VERCEL_ACCESS_TOKEN=your_vercel_access_token
# Find project ID at: Vercel dashboard > Project Settings > General
VERCEL_PROJECT_ID=your_vercel_project_id

# YouTube Data API v3 (for fetching latest live video automatically)
# 1. Go to: https://console.cloud.google.com
# 2. Create a project (or select existing)
# 3. Enable "YouTube Data API v3" in APIs & Services
# 4. Create credentials > API key
YOUTUBE_API_KEY=your_youtube_api_key

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================
# 1. Copy this file to .env.local
#    cp .env.local.example .env.local
#
# 2. Fill in your Cloudinary credentials from:
#    https://cloudinary.com/console
#
# 3. For Vercel deployment, add these as
#    Environment Variables in Vercel dashboard:
#    Settings > Environment Variables
#
# 4. For NextAuth Google Login:
#    - Create OAuth credentials at Google Cloud Console
#    - Add authorized redirect URI:
#      https://your-domain.vercel.app/api/auth/callback/google
#    - Set ALLOWED_ADMIN_EMAILS to your admin email(s)
